---
import Language from "@/components/Language.astro";
import Hamburger from "@/components/Hamburger.astro";
import Theme from "@/components/Theme.astro";
import ContactHeader from "@/components/ContactHeader.astro";
import { SECTIONS } from "@/data/links";
import type { I18nTranslations } from "@app-types/types";

const data: I18nTranslations = Astro.props.data;
const links = SECTIONS.map(({ id, key }) => ({ id, label: data[key].title }));
---

<header
  class="fixed top-0 z-50 flex h-16 w-full items-center justify-between border-b border-line bg-bg/80 px-6 backdrop-blur-md md:px-10"
>
  <Hamburger data={data} />

  <nav aria-label={data.ui.nav.label} class="mr-auto hidden lg:block">
    <ul class="flex items-center gap-6 lg:gap-8">
      {
        links.map(({ id, label }) => (
          <li>
            <a
              href={`#${id}`}
              data-section-link={id}
              class="eyebrow transition-colors whitespace-nowrap !text-muted hover:!text-fg aria-[current=true]:!text-accent"
            >
              {label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <div class="ml-auto flex items-center text-fg">
    <ContactHeader data={data} />
    <Theme data={data} />
    <Language data={data} />
  </div>
</header>

<script>
  const header = document.querySelector("header");
  document.addEventListener("scroll", () => {
    header?.classList.toggle("shadow-sm", globalThis.scrollY > 0);
  });

  const links = document.querySelectorAll<HTMLAnchorElement>("[data-section-link]");
  const byId = new Map(Array.from(links).map((a) => [a.dataset.sectionLink!, a]));
  const visible = new Set<string>();

  const setCurrent = () => {
    const current = Array.from(byId.keys()).find((id) => visible.has(id));
    byId.forEach((a, id) => a.setAttribute("aria-current", String(id === current)));
  };

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        const id = (e.target as HTMLElement).dataset.navTarget!;
        if (e.isIntersecting) visible.add(id);
        else visible.delete(id);
      });
      setCurrent();
    },
    { rootMargin: "-30% 0px -50% 0px" },
  );

  byId.forEach((_, id) => {
    const el = document.getElementById(id);
    if (!el) return;
    const block = (el.closest(".reveal-element") as HTMLElement | null) ?? el;
    block.dataset.navTarget = id;
    observer.observe(block);
  });
</script>
