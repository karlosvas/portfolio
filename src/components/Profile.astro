---
import type { Lang } from "@app-types/enums";
import type { I18nTranslations } from "@app-types/types";
import ImageShader from "@/components/ImageShader.astro";
import { toCardinal as toCardinalEs } from "n2words/es-ES";
import { toCardinal as toCardinalEn } from "n2words/en-US";

const data: I18nTranslations = Astro.props.data;
const currentLang = Astro.currentLocale as Lang;

const birthDate = new Date(2004, 3, 13);
const today = new Date();
const age =
  today.getFullYear() -
  birthDate.getFullYear() -
  (today < new Date(today.getFullYear(), birthDate.getMonth(), birthDate.getDate()) ? 1 : 0);

const ageLabel: string = currentLang === "es" ? toCardinalEs(age) : toCardinalEn(age);
---

<div id="profile" class="grid min-h-[90dvh] items-center justify-center gap-8 px-4 py-10 md:w-3/4 lg:grid-cols-2">
  <!-- Img Profile -->
  <ImageShader />

  <!-- Info Profile -->
  <section class="flex flex-col justify-center space-y-4">
    <!-- Name -->
    <div class="select-none space-y-2">
      <h1
        id="title"
        class="bg-gradient-to-r from-blue-500 via-purple-600 to-pink-900 bg-clip-text text-4xl font-bold text-transparent lg:min-h-10"
      >
        {" "}
      </h1>
      <p class="font-fraunces text-lg text-purplePal/80 md:text-xl">{data.profile.subtitle}</p>
    </div>
    <!-- Info -->
    <div class="space-y-4 text-base leading-relaxed md:text-base">
      <p class="transition-opacity text-pretty opacity-90 duration-300 hover:opacity-100">
        {data.profile.presentation.v1.replace("{age}", ageLabel)}
      </p>
      <p class="transition-opacity text-pretty opacity-90 duration-300 hover:opacity-100">
        {data.profile.presentation.v2}
      </p>
    </div>
  </section>
</div>
<script is:inline define:vars={{ data }}>
  async function updateTitle(name) {
    const title = document.getElementById("title");

    if (title) {
      title.innerHTML = "";
      title.style.minHeight = "5rem";

      const textSpan = document.createElement("span");
      textSpan.style.whiteSpace = "pre-line";

      const cursorSpan = document.createElement("span");
      cursorSpan.innerText = "|";
      cursorSpan.classList.add("blinking-cursor");
      cursorSpan.style.display = "inline-block";
      cursorSpan.style.width = "0.5em";

      title.appendChild(textSpan);
      title.appendChild(cursorSpan);

      let result = "";
      for (let i = 0; i < name.length; i++) {
        await new Promise((resolve) => setTimeout(resolve, 100));
        result += name[i];
        if (result === "Carlos Raúl") result += "\n";
        textSpan.textContent = result;
      }

      cursorSpan.style.animation = "blink 1s infinite";
      setTimeout(() => {
        cursorSpan.remove();
      }, 3000);
    }
  }

  globalThis.addEventListener("DOMContentLoaded", () => updateTitle(data.profile.name));
</script>
<style>
  @keyframes blink {
    0%,
    100% {
      opacity: 0;
    }
    50% {
      opacity: 1;
    }
  }
</style>
