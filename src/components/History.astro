---
import ButtonCustomized from "./ButtonCustomized.astro";
import SectionHeading from "./SectionHeading.astro";
import { getEntry } from "astro:content";
const { currentLocale } = Astro;

const { data } = Astro.props;

const R2_URL = import.meta.env.PUBLIC_R2_PUBLIC_URL;
const cvId = currentLocale === "en" ? "current-en" : "current-es";
const cv = await getEntry("cv", cvId);
if (!cv) throw new Error(`CV entry not found for locale: ${currentLocale}`);
---

<div class="mb-32 flex h-auto w-full flex-col items-start">
  <SectionHeading num="03" title={data.history.title} id="history" />
  <div class="w-full space-y-10">
    {
      data.history.jobs.map((job: any) => (
        <article class="grid gap-x-8 gap-y-2 md:grid-cols-[11rem_1fr]">
          <p class="eyebrow !text-muted md:pt-1.5">{job.date}</p>
          <div>
            <h3 class="text-xl font-semibold text-fg">{job.title}</h3>
            <p class="font-medium text-accent">{job.company}</p>
            <p class="mt-3 max-w-2xl text-pretty text-fg/80">{job.description}</p>
          </div>
        </article>
      ))
    }
  </div>
  <ButtonCustomized href={R2_URL + cv.data.pdfUrl} target="_blank" customStyle="mt-12 self-center px-8">
    {data.history.viewFullResume}
  </ButtonCustomized>
</div>
