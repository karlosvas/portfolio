---
interface Props {
  customStyle?: string;
  href?: string;
  target?: string;
}

const { customStyle, href, target } = Astro.props;
const classes = `inline-block rounded-sm border border-accent bg-accent px-5 py-2.5 text-center font-mono text-xs font-medium uppercase tracking-[0.15em] text-accent-fg transition-colors duration-200 hover:bg-transparent hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 disabled:opacity-60 ${customStyle ?? ""}`;
---

{
  href ? (
    <a href={href} target={target} rel={target === "_blank" ? "noopener noreferrer" : undefined} class={classes}>
      <slot />
    </a>
  ) : (
    <button type="submit" class={classes}>
      <slot />
    </button>
  )
}
