---
import type { I18nTranslations } from "@/../types/types";
import SectionHeading from "./SectionHeading.astro";
import ProjectCard from "./ProjectCard.astro";

const data: I18nTranslations = Astro.props.data;
const { showMore, showLess, others, goToProject, goToRepo } = data.ui.projects;

const toCards = (list: I18nTranslations["projects"]["list"]) =>
  Object.entries(list).map(([key, project]) => ({ key, ...project }));
const grid = "grid w-full grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3";
// Tamaños variables de las tarjetas (patrón de 5), como en el diseño original
const sizes = [
  "md:col-span-1 lg:col-span-2",
  "md:col-span-1 lg:col-span-1",
  "md:col-span-2 lg:col-span-1",
  "md:col-span-1 lg:col-span-2",
  "md:col-span-1 lg:col-span-1",
];
---

<div class="mb-32 flex h-auto w-full flex-col items-center">
  <SectionHeading num="01" title={data.projects.title} id="projects" />

  <div class={grid}>
    {
      toCards(data.projects.list).map((p, i) => (
        <ProjectCard
          class={sizes[i % sizes.length]}
          projectKey={p.key}
          name={p.name}
          description={p.description}
          url={p.url}
          goToProject={goToProject}
          goToRepo={goToRepo}
        />
      ))
    }
  </div>

  <button
    id="show-more"
    type="button"
    aria-expanded="false"
    aria-controls="others"
    data-label-more={showMore}
    data-label-less={showLess}
    class="eyebrow transition-colors mt-10 inline-flex items-center gap-3 border border-line px-5 py-2 hover:border-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
  >
    <span data-label>{showMore}</span>
    <svg
      class="chevron h-3 w-3"
      viewBox="0 0 12 12"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M2 4.5 6 8.5 10 4.5"></path>
    </svg>
  </button>

  <section id="others" class="others w-full" data-open="false" inert>
    <div class="others-inner">
      <div class="mb-10 mt-16 flex items-center gap-4">
        <h3 class="eyebrow shrink-0 !text-xs">
          <span class="text-muted">01.1</span><span class="ml-2">{others}</span>
        </h3>
        <span class="h-px flex-1 bg-line"></span>
      </div>
      <div class={grid}>
        {
          toCards(data.projects.others).map((p, i) => (
            <ProjectCard
              class={sizes[i % sizes.length]}
              projectKey={p.key}
              name={p.name}
              description={p.description}
              url={p.url}
              goToProject={goToProject}
              goToRepo={goToRepo}
            />
          ))
        }
      </div>
    </div>
  </section>
</div>

<script>
  const button = document.getElementById("show-more") as HTMLButtonElement | null;
  const others = document.getElementById("others");
  const label = button?.querySelector<HTMLElement>("[data-label]");
  const reduceMotion = globalThis.matchMedia("(prefers-reduced-motion: reduce)");

  button?.addEventListener("click", () => {
    if (!others) return;
    const open = others.dataset.open !== "true";

    button.setAttribute("aria-expanded", String(open));
    if (label) label.textContent = (open ? button.dataset.labelLess : button.dataset.labelMore) ?? "";

    others.dataset.open = String(open);
    others.toggleAttribute("inert", !open);
    // Mientras se anima hay que recortar; al terminar de abrir se libera (sombras, inclinación 3D)
    if (!open) delete others.dataset.settled;

    if (open) {
      // Si el contenido nuevo queda fuera de pantalla, acerca la vista para que se vea la animación
      const heading = others.querySelector("h3");
      const top = heading?.getBoundingClientRect().top ?? 0;
      if (top > globalThis.innerHeight * 0.6) {
        globalThis.scrollBy({
          top: top - globalThis.innerHeight * 0.3,
          behavior: reduceMotion.matches ? "auto" : "smooth",
        });
      }
    }
  });

  others?.addEventListener("transitionend", (e) => {
    if (e.propertyName === "grid-template-rows" && others.dataset.open === "true") others.dataset.settled = "true";
  });
</script>

<style is:global>
  /* Despliegue: la altura anima de 0fr a 1fr (sin medir alturas con JS) */
  .others {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition:
      grid-template-rows 0.7s cubic-bezier(0.23, 1, 0.32, 1),
      opacity 0.35s ease;
  }
  .others[data-open="true"] {
    grid-template-rows: 1fr;
    opacity: 1;
    transition:
      grid-template-rows 0.7s cubic-bezier(0.23, 1, 0.32, 1),
      opacity 0.5s ease 0.1s;
  }
  .others-inner {
    min-height: 0;
    overflow: hidden;
  }
  .others[data-settled="true"] .others-inner {
    overflow: visible;
  }

  /* Las tarjetas entran escalonadas. `backwards`: al acabar se libera el transform (hover 3D) */
  .others[data-open="true"] article {
    animation: others-card-in 0.7s cubic-bezier(0.23, 1, 0.32, 1) backwards;
  }
  .others[data-open="true"] article:nth-child(1) {
    animation-delay: 0.12s;
  }
  .others[data-open="true"] article:nth-child(2) {
    animation-delay: 0.2s;
  }
  .others[data-open="true"] article:nth-child(3) {
    animation-delay: 0.28s;
  }
  .others[data-open="true"] article:nth-child(4) {
    animation-delay: 0.36s;
  }
  .others[data-open="true"] article:nth-child(n + 5) {
    animation-delay: 0.44s;
  }
  @keyframes others-card-in {
    from {
      opacity: 0;
      transform: translateY(28px) scale(0.97);
    }
  }

  #show-more .chevron {
    transition: transform 0.4s cubic-bezier(0.23, 1, 0.32, 1);
  }
  #show-more[aria-expanded="true"] .chevron {
    transform: rotate(180deg);
  }
</style>
