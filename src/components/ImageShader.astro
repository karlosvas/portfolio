---
// Marco vertical 4:5: respeta la foto (que es vertical) y no la recorta por los lados.
---

<div class="relative mx-auto aspect-[4/5] w-64 md:w-72 lg:w-80">
  <span class="absolute inset-0 translate-x-3 translate-y-3 rounded-sm border border-accent/50"></span>
  <!-- Imagen estática: es lo que se ve sin WebGL2 / sin JS y mientras carga el lienzo -->
  <img
    src="/img/profile.webp"
    alt=""
    width="320"
    height="400"
    fetchpriority="high"
    class="absolute inset-0 h-full w-full select-none rounded-sm border-2 border-accent bg-surface object-cover object-[50%_15%]"
    data-image-fallback
  />
  <canvas
    class="absolute inset-0 hidden h-full w-full select-none rounded-sm border-2 border-accent bg-surface"
    data-image-shader
    aria-hidden="true"></canvas>
</div>

<script>
  import { attachHoverEffect } from "@/services/hoverEffect";

  const canvas = document.querySelector<HTMLCanvasElement>("[data-image-shader]");
  const image = document.querySelector<HTMLImageElement>("[data-image-fallback]");
  if (canvas && image && canvas.parentElement) {
    // focus igual que object-[50%_15%] de la <img>
    attachHoverEffect({ container: canvas.parentElement, canvas, image, focus: [0.5, 0.15] });
  }
</script>
